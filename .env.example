# Optional quote notifications. Use a verified sender and the intended business recipient.
# Load these into the server process environment; this project does not auto-load .env files.
HIGHDUSTING_SMTP_HOST=
HIGHDUSTING_SMTP_PORT=465
HIGHDUSTING_SMTP_USER=
HIGHDUSTING_SMTP_PASSWORD=
HIGHDUSTING_EMAIL_FROM=
HIGHDUSTING_QUOTE_EMAIL=info@highdusting.ca
# HIGHDUSTING_DATA_DIR=/absolute/private/persistent/volume
